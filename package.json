{
  "name": "@bowtiedbluefin/plugin-morpheus",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --write ./src",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.34",
    "@elizaos/core": "^1.0.12",
    "ai": "^3.2.38",
    "formdata-node": "^6.0.3",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@elizaos/core": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "prettier": "3.5.3"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "MORPHEUS_API_KEY": {
        "type": "string",
        "description": "Morpheus API key",
        "required": true
      },
      "MORPHEUS_SMALL_MODEL": {
        "type": "string",
        "description": "Morpheus small model for text generation",
        "default": "mistral-31-24b"
      },
      "MORPHEUS_LARGE_MODEL": {
        "type": "string",
        "description": "Morpheus large model for text generation",
        "default": "qwen3-235b"
      },
      "EMBEDDING_PROVIDER": {
        "type": "string",
        "description": "Choose your embedding provider.",
        "enum": ["openai", "venice"]
      },
      "EMBEDDING_API_KEY": {
        "type": "string",
        "description": "API key for your chosen embedding provider (OpenAI or Venice).",
        "required": true
      },
      "EMBEDDING_MODEL": {
        "type": "string",
        "description": "Optional. Embedding model to use. Press Enter to use the default for your chosen provider.",
        "required": false
      },
      "EMBEDDING_DIMENSIONS": {
        "type": "number",
        "description": "Optional custom dimensions for embeddings.",
        "default": 1024
      }
    }
  }
}