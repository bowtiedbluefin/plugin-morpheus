{
  "name": "@elizaos/plugin-morpheus",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --write ./src",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.34",
    "@elizaos/core": "^1.0.12",
    "ai": "^3.2.38",
    "formdata-node": "^6.0.3",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@elizaos/core": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "prettier": "3.5.3"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "MORPHEUS_API_KEY": {
        "type": "string",
        "description": "Morpheus API key",
        "required": true
      },
      "MORPHEUS_SMALL_MODEL": {
        "type": "string",
        "description": "Morpheus small model for text generation",
        "default": "mistral-31-24b"
      },
      "MORPHEUS_LARGE_MODEL": {
        "type": "string",
        "description": "Morpheus large model for text generation",
        "default": "qwen3-235b"
      },
      "EMBEDDING_PROVIDER": {
        "type": "string",
        "description": "The embedding provider to use, either 'openai' or 'venice'",
        "default": "openai"
      },
      "OPENAI_API_KEY": {
        "type": "string",
        "description": "OpenAI API key for embeddings",
        "required": false
      },
      "OPENAI_EMBEDDING_MODEL": {
        "type": "string",
        "description": "OpenAI embedding model",
        "default": "text-embedding-3-small"
      },
      "OPENAI_EMBEDDING_DIMENSIONS": {
        "type": "number",
        "description": "Optional custom dimensions for OpenAI embeddings"
      },
      "VENICE_API_KEY": {
        "type": "string",
        "description": "Venice API key for embeddings",
        "required": false
      },
      "VENICE_EMBEDDING_MODEL": {
        "type": "string",
        "description": "Venice embedding model",
        "default": "text-embedding-bge-m3"
      },
      "VENICE_EMBEDDING_DIMENSIONS": {
        "type": "number",
        "description": "Optional custom dimensions for Venice embeddings"
      }
    }
  }
}